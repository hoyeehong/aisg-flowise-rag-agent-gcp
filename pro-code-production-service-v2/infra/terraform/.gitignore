# Provider binaries and lock state: large, platform-specific, and regenerated by init.
.terraform/
# Local state can contain secrets in plaintext. The backend is remote; a stray local
# state file must never reach the repository.
*.tfstate
*.tfstate.*
# Variable files routinely hold project ids and credentials.
*.tfvars
!example.tfvars
crash.log
# Terraform merges these over the real configuration, so a stray one silently changes
# what an apply does. Scratch overrides must stay local.
*_override.tf
*_override.tf.json
