# =====================================================================
# v2 service configuration. Copy to .env (gitignored) and fill in.
#   cp .env.example .env
# =====================================================================

# --- Model gateway ---------------------------------------------------
# The system under test. Either name works: the unprefixed provider
# variable is accepted alongside the AGENT_-prefixed form.
GROQ_API_KEY="your-groq-api-key"

# Fallback chain, highest preference first. The gateway advances on quota
# exhaustion, retries transient faults, and retires unknown models.
AGENT_MODEL_CHAIN="openai/gpt-oss-20b,llama-3.3-70b-versatile"

# USD per million tokens, used by the per-request cost meter. Declared
# rather than fetched so a cost figure is reproducible from the code.
AGENT_USD_PER_MILLION_INPUT="0.10"
AGENT_USD_PER_MILLION_OUTPUT="0.50"
AGENT_REQUEST_TIMEOUT_SECONDS="60"

# --- Agent behaviour -------------------------------------------------
AGENT_DEFAULT_TOP_K="5"
# Ceiling on the human-review revision loop. Exhausting it halts the run
# and returns the latest draft rather than looping indefinitely.
AGENT_MAX_REVISIONS="3"

# --- Retrieval -------------------------------------------------------
# "true"  -> in-memory token-overlap retriever, no infrastructure needed.
# "false" -> pgvector hybrid retrieval (needs AGENT_POSTGRES_DSN and,
#            for semantic recall, GEMINI_API_KEY).
AGENT_USE_IN_MEMORY_RETRIEVER="false"

# Postgres, shared by the vector store and the LangGraph checkpointer.
# Local development: docker compose up -d postgres
AGENT_POSTGRES_DSN="postgresql://postgres:devpass@localhost:55432/agent"

# Embeddings come from Google; chat models come from Groq. Either the
# prefixed or unprefixed name works.
GEMINI_API_KEY="your-google-api-key"
AGENT_EMBEDDING_MODEL="gemini-embedding-001"
# gemini-embedding-001 is native 3072-dim and supports truncation. 768 is a
# quarter of the storage and index size for a small quality cost on this
# corpus. Must match the VECTOR(n) column width.
AGENT_EMBEDDING_DIMENSIONS="768"
AGENT_TENANT_ID="default"

# --- Tenancy and authentication --------------------------------------
# The tenant a request may read is taken from a verified token claim, never
# from a header or body: row-level security enforces faithfully against
# whatever identifier it is handed, so a caller-supplied one is enforced
# just as faithfully.
#
# Empty secret disables enforcement, and /readyz then reports 503 unless
# AGENT_ALLOW_ANONYMOUS_TENANT is set -- a missing credential must not
# quietly become an accepted configuration.
AGENT_JWT_SECRET=""                 # HS256 shared secret, >= 32 bytes (RFC 7518 3.2)
AGENT_JWT_ALGORITHM="HS256"         # HS256/HS384/HS512; RS256 is not implemented
AGENT_JWT_AUDIENCE=""               # verified only when set
AGENT_JWT_ISSUER=""                 # verified only when set
AGENT_JWT_TENANT_CLAIM="tenant_id"  # which claim carries the tenant
# Serve AGENT_TENANT_ID with no credential at all. Local development and CI
# only: this is single-tenant operation with no authentication.
AGENT_ALLOW_ANONYMOUS_TENANT="false"

# The service queries as a NOSUPERUSER NOBYPASSRLS role so the RLS policy on
# `chunks` actually applies. A superuser ignores policies outright, and FORCE
# ROW LEVEL SECURITY only subjects the table owner -- so connecting as
# `postgres` makes the policy inert while every test still passes. /readyz
# measures enforcement rather than reporting configuration.
#
# DDL needs ownership, so bootstrap uses a separate DSN. Empty falls back to
# AGENT_POSTGRES_DSN, which keeps a single-DSN local setup working at the
# cost of RLS being inert there.
AGENT_POSTGRES_ADMIN_DSN=""
# When set, bootstrap creates and grants this role. Leave empty in
# production, where the role and its password come from Terraform.
AGENT_POSTGRES_APP_ROLE=""
AGENT_POSTGRES_APP_PASSWORD=""

# --- Event-driven ingestion ------------------------------------------------
# The consumer runs as its own process:
#   uv run python -m digital_economy_agent.messaging
# It refuses to start without a subscription rather than idling in a
# ready-looking process that consumes nothing.
AGENT_PUBSUB_SUBSCRIPTION=""        # projects/<project>/subscriptions/<name>
# Required in practice, not just recommended: Pub/Sub populates delivery_attempt
# only on subscriptions that have a dead-letter policy. Without one the
# consumer's retry ceiling never fires and a message that can never succeed is
# redelivered forever.
AGENT_PUBSUB_DEAD_LETTER_TOPIC=""   # projects/<project>/topics/<name>
# Keep in step with the subscription's own max_delivery_attempts, or one ceiling
# fires before the other.
AGENT_CONSUMER_MAX_DELIVERY_ATTEMPTS="5"
# Bounded because the embedding provider rate-limits. Letting the broker set the
# fan-out turns a backlog into a wall of 429s, which the gateway backs off on,
# which makes the backlog worse.
AGENT_CONSUMER_CONCURRENCY="4"
AGENT_CONSUMER_MAX_MESSAGES="10"
AGENT_CONSUMER_POLL_INTERVAL_SECONDS="1.0"
# /healthz, /readyz and /metrics for the consumer process. Without them a
# Kubernetes Deployment has no probe target and Prometheus nothing to scrape, so
# a consumer that stopped pulling looks exactly like one with no work.
AGENT_CONSUMER_PORT="8081"

# --- Hybrid search ---------------------------------------------------
# Each strategy fetches top_k * multiplier candidates before fusion: RRF can
# only reorder what it is given, so a candidate missing from both pools can
# never be recovered.
AGENT_RETRIEVAL_CANDIDATE_MULTIPLIER="4"
AGENT_RETRIEVAL_VECTOR_WEIGHT="1.0"
AGENT_RETRIEVAL_LEXICAL_WEIGHT="1.0"
# MMR diversification: 1.0 pure relevance, 0.0 pure diversity. Matters here
# because the 200-char chunk overlap makes neighbours share text.
AGENT_RETRIEVAL_MMR_LAMBDA="0.7"
AGENT_RETRIEVAL_ENABLE_MMR="true"
# 0 disables LLM query rewriting, which costs one extra model call per retrieval.
AGENT_RETRIEVAL_REWRITE_VARIANTS="0"

# --- Durability ------------------------------------------------------
# With Postgres configured, human-review pauses survive a restart. Without
# it the graph falls back to an in-process saver and a restart loses them.
AGENT_USE_POSTGRES_CHECKPOINTER="true"

# --- Observability ---------------------------------------------------
# /metrics always serves Prometheus exposition format; nothing to configure.
# Tracing is opt-in: an exporter pointing at a collector that is not there
# retries in the background and adds latency to every request, so a missing
# telemetry sidecar must not become a user-visible problem.
AGENT_OTLP_ENDPOINT=""              # e.g. otel-collector:4317
AGENT_TRACE_TO_CONSOLE="false"      # local span inspection without a collector
AGENT_SERVICE_NAME="digital-economy-agent"

# --- Runtime ---------------------------------------------------------
AGENT_ENVIRONMENT="development"
AGENT_LOG_LEVEL="INFO"
