# =====================================================================
# LADP-Essentials Scenario 5: GCP Cloud Run Deployment Configuration
# =====================================================================

# 1. GCP Project & Region Settings
GCP_PROJECT_ID="your-gcp-project-id"
GCP_REGION="asia-southeast1" # Singapore
SERVICE_NAME="flowise-capstone"

# 2. Flowise Admin Authentication (Module 4.4 Security)
FLOWISE_USERNAME="admin"
# Leave blank to have the script generate one and store it in Secret Manager.
FLOWISE_PASSWORD=""

# 3. Model API Keys (Injected into Google Secret Manager)
# GROQ_API_KEY  -> the system under test: the Research and Writer agents run on
#                  Groq openai/gpt-oss-20b (see flowise_scenario_5_workflow.json)
# GEMINI_API_KEY-> the evaluation judge ONLY. Deliberately a different model family
#                  from the system under test, to avoid self-preference bias.
GROQ_API_KEY="your-groq-api-key"
GEMINI_API_KEY="your-google-ai-studio-gemini-api-key"
PINECONE_API_KEY="your-pinecone-api-key"

# 4. Storage & Resource Allocations
BUCKET_NAME="flowise-data-your-gcp-project-id"
CPU_LIMIT="2"
MEMORY_LIMIT="2Gi"
# Flowise uses SQLite on a GCS FUSE mount, which lacks the POSIX locking SQLite
# needs. Keep at 1 until DATABASE_TYPE is migrated to Postgres.
MAX_INSTANCES="1"
MIN_INSTANCES="0" # Scale to zero when idle for cost efficiency
